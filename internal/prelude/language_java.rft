;; -*- mode: lisp; -*-
;; java — place wraps verb (SPEC.md Extract dialect).
;; Uses under def places use (scope name).

(under (path "**/*.java")
  (as-language "java")
  (as-layout package import body)
  (as-family "jvm" directory-module package-scoped-bare-names empty-package-dir-scoped nested-type-members)
  (as-import (seq "import" path ";"))
  (as-docstring comment-before-c)

  (under (node "package_declaration")
    (under (node "scoped_identifier")
      (as-package))
    (under (node "identifier")
      (as-package)))

  ;; Type nest so method atoms join name+name → Type.method.
  ;; Uses stay under the method so (scope name) is the method, not the type.
  (under (node "class_declaration")
    (as-scope (this))
    (as-atom public (take "name" (seq "public" (* (not "class")) "class" (capture name any))))
    (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "class")))) "class" (capture name any))))
    (under (take "interfaces" (node "class_declaration"))
      (under (node "type_identifier")
        (as-use (scope name))))
    (under (take "superclass" (node "class_declaration"))
      (under (node "type_identifier")
        (as-use (scope name))))
    (under (node "method_declaration")
      (as-scope (this))
      (as-atom public (take "name" (seq "public" (* (not "(")) (capture name any) "(")))
      (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "(")))) (capture name any) "(")))
      (under (node "local_variable_declaration")
        (as-atom private (take "name" (node "variable_declarator"))))
      (under (node "formal_parameter")
        (as-atom private (take "name" (node "formal_parameter"))))
      (under (node "field_access")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "." (capture name any)))))
      (under (node "field_access")
        (as-use (scope name) (take "field" (node "field_access"))))
      (under (node "method_invocation")
        (as-use (scope name) (take "name" (node "method_invocation"))))
      (under (node "method_reference")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "::" (capture name any)))))
      (under (node "method_reference")
        (as-use (scope name) (node "method_reference")))
      (under (node "switch_label")
        (under (node "identifier")
          (as-use (scope name))))
      (under (node "identifier")
        (as-use (scope name)))
      (under (node "type_identifier")
        (as-use (scope name))))
    (under (node "field_declaration")
      (as-decl (this))
      (as-atom public (take "name" (node "variable_declarator")))
      (under (node "variable_declarator")
        (as-scope (this))))
    (under (node "class_declaration")
      (as-atom public (take "name" (seq "public" (* (not "class")) "class" (capture name any))))
    (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "class")))) "class" (capture name any))))
      (under (take "interfaces" (node "class_declaration"))
        (under (node "type_identifier")
          (as-use (scope name))))
      (under (take "superclass" (node "class_declaration"))
        (under (node "type_identifier")
          (as-use (scope name))))
      (under (node "field_declaration")
        (as-decl (this))
        (under (node "variable_declarator")
          (as-scope (this))
          (as-atom public (take "name" (node "variable_declarator")))))
      (under (node "method_declaration")
        (as-atom public (take "name" (seq "public" (* (not "(")) (capture name any) "(")))
        (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "(")))) (capture name any) "("))))
      (under (node "enum_declaration")
        (as-atom public (take "name" (seq "public" (* (not "enum")) "enum" (capture name any))))
    (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "enum")))) "enum" (capture name any))))
        (as-atom public (take "name"
          (seq "enum" any "{" (capture name any) "," (capture name any) ";")))
        (as-atom public (take "name"
          (seq "enum" any "{" (capture name any) "," (capture name any) "}")))
        (as-atom public (take "name"
          (seq "enum" any "{" (capture name any) "," (capture name any) "," (capture name any) ";")))
        (as-atom public (take "name"
          (seq "enum" any "{" (capture name any) "," (capture name any) "," (capture name any) "}")))
        (as-atom public (take "name"
          (seq "enum" any "{" (capture name any) "{")))
        (as-atom public (take "name"
          (seq "enum" any "{" (* (not ",")) "," (capture name any) "{")))
        (under (node "enum_constant")
          (as-atom public (take "name" (node "enum_constant"))))))
    (under (node "record_declaration")
      (as-atom public (take "name" (seq "public" (* (not "record")) "record" (capture name any) "(")))
    (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "record")))) "record" (capture name any) "(")))
      (under (node "formal_parameter")
        (as-atom private (take "name" (node "formal_parameter")))))
    (under (node "constructor_declaration")
      (as-scope (this))
      (under (node "local_variable_declaration")
        (as-atom private (take "name" (node "variable_declarator"))))
      (under (node "formal_parameter")
        (as-atom private (take "name" (node "formal_parameter"))))
      (under (node "field_access")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "." (capture name any)))))
      (under (node "field_access")
        (as-use (scope name) (take "field" (node "field_access"))))
      (under (node "method_invocation")
        (as-use (scope name) (take "name" (node "method_invocation"))))
      (under (node "method_reference")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "::" (capture name any)))))
      (under (node "method_reference")
        (as-use (scope name) (node "method_reference")))
      (under (node "switch_label")
        (under (node "identifier")
          (as-use (scope name))))
      (under (node "identifier")
        (as-use (scope name)))
      (under (node "type_identifier")
        (as-use (scope name)))))

  (under (node "interface_declaration")
    (as-scope (this))
    (as-atom public (take "name" (seq "public" (* (not "interface")) "interface" (capture name any))))
    (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "interface")))) "interface" (capture name any))))
    (under (take "interfaces" (node "interface_declaration"))
      (under (node "type_identifier")
        (as-use (scope name))))
    (under (node "method_declaration")
      (as-scope (this))
      (as-atom public (take "name" (node "method_declaration")))
      (under (node "local_variable_declaration")
        (as-atom private (take "name" (node "variable_declarator"))))
      (under (node "formal_parameter")
        (as-atom private (take "name" (node "formal_parameter"))))
      (under (node "field_access")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "." (capture name any)))))
      (under (node "field_access")
        (as-use (scope name) (take "field" (node "field_access"))))
      (under (node "method_invocation")
        (as-use (scope name) (take "name" (node "method_invocation"))))
      (under (node "method_reference")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "::" (capture name any)))))
      (under (node "method_reference")
        (as-use (scope name) (node "method_reference")))
      (under (node "switch_label")
        (under (node "identifier")
          (as-use (scope name))))
      (under (node "identifier")
        (as-use (scope name)))
      (under (node "type_identifier")
        (as-use (scope name)))))

  (under (node "enum_declaration")
    (as-scope (this))
    (as-atom public (take "name" (seq "public" (* (not "enum")) "enum" (capture name any))))
    (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "enum")))) "enum" (capture name any))))
    (under (take "interfaces" (node "enum_declaration"))
      (under (node "type_identifier")
        (as-use (scope name))))
    (as-atom public (take "name"
      (seq "enum" any "{" (capture name any) "," (capture name any) ";")))
    (as-atom public (take "name"
      (seq "enum" any "{" (capture name any) "," (capture name any) "}")))
    (as-atom public (take "name"
      (seq "enum" any "{" (capture name any) "," (capture name any) "," (capture name any) ";")))
    (as-atom public (take "name"
      (seq "enum" any "{" (capture name any) "," (capture name any) "," (capture name any) "}")))
    (as-atom public (take "name"
      (seq "enum" any "{" (capture name any) "{")))
    (as-atom public (take "name"
      (seq "enum" any "{" (* (not ",")) "," (capture name any) "{")))
    (under (node "enum_constant")
      (as-atom public (take "name" (node "enum_constant"))))
    (under (node "method_declaration")
      (as-scope (this))
      (as-atom public (take "name" (seq "public" (* (not "(")) (capture name any) "(")))
      (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "(")))) (capture name any) "(")))
      (under (node "local_variable_declaration")
        (as-atom private (take "name" (node "variable_declarator"))))
      (under (node "formal_parameter")
        (as-atom private (take "name" (node "formal_parameter"))))
      (under (node "field_access")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "." (capture name any)))))
      (under (node "field_access")
        (as-use (scope name) (take "field" (node "field_access"))))
      (under (node "method_invocation")
        (as-use (scope name) (take "name" (node "method_invocation"))))
      (under (node "method_reference")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "::" (capture name any)))))
      (under (node "method_reference")
        (as-use (scope name) (node "method_reference")))
      (under (node "switch_label")
        (under (node "identifier")
          (as-use (scope name))))
      (under (node "identifier")
        (as-use (scope name)))
      (under (node "type_identifier")
        (as-use (scope name)))))

  (under (node "record_declaration")
    (as-scope (this))
    (as-atom public (take "name" (seq "public" (* (not "record")) "record" (capture name any) "(")))
    (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "record")))) "record" (capture name any) "(")))
    (under (take "interfaces" (node "record_declaration"))
      (under (node "type_identifier")
        (as-use (scope name))))
    (under (node "formal_parameter")
      (as-atom private (take "name" (node "formal_parameter"))))
    (under (node "method_declaration")
      (as-scope (this))
      (as-atom public (take "name" (seq "public" (* (not "(")) (capture name any) "(")))
      (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "(")))) (capture name any) "(")))
      (under (node "local_variable_declaration")
        (as-atom private (take "name" (node "variable_declarator"))))
      (under (node "formal_parameter")
        (as-atom private (take "name" (node "formal_parameter"))))
      (under (node "field_access")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "." (capture name any)))))
      (under (node "field_access")
        (as-use (scope name) (take "field" (node "field_access"))))
      (under (node "method_invocation")
        (as-use (scope name) (take "name" (node "method_invocation"))))
      (under (node "method_reference")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "::" (capture name any)))))
      (under (node "method_reference")
        (as-use (scope name) (node "method_reference")))
      (under (node "switch_label")
        (under (node "identifier")
          (as-use (scope name))))
      (under (node "identifier")
        (as-use (scope name)))
      (under (node "type_identifier")
        (as-use (scope name)))))

  (under (node "annotation_type_declaration")
    (as-scope (this))
    (as-atom public (take "name" (seq "public" (* (not "@interface")) "@interface" (capture name any))))
    (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "@interface")))) "@interface" (capture name any))))
    (under (node "annotation_type_element_declaration")
      (as-atom public (take "name" (node "annotation_type_element_declaration")))))

  (under (node "method_declaration")
    (as-atom public (take "name" (seq "public" (* (not "(")) (capture name any) "(")))
    (as-atom private (take "name" (seq (assert_not_behind (seq "public" (* (not "(")))) (capture name any) "("))))

  ;; Typed bindings: try (A a), catch (A e), instanceof A a, case A a, Box(A a).
  (under (node "resource")
    (as-atom private (take "name" (node "resource"))))
  (under (node "catch_formal_parameter")
    (as-atom private (take "name"
      (seq any (capture name any)))))
  (under (node "instanceof_expression")
    (as-atom private (take "name"
      (seq any "instanceof" any (capture name (regex "[A-Za-z_][A-Za-z0-9_]*"))))))
  (under (node "type_pattern")
    (as-atom private (take "name"
      (seq any (capture name any)))))
  (under (node "record_pattern_component")
    (as-atom private (take "name"
      (seq any (capture name any)))))
  (under (node "enhanced_for_statement")
    (as-atom private (take "name" (node "enhanced_for_statement"))))

  (under (node "import_declaration")
    (as-import (node "import_declaration")))
  (under (node "import_declaration")
    (as-import
      (seq "static" (capture path (seq any "." any)) "." (capture name any) ";")))

  ;; file-level uses (no bare identifier — locals must not become uses)
  (under (node "field_access")
    (as-use
      (take "name"
        (seq (capture name any) "." (capture name any)))))
  (under (node "field_access")
    (as-use (take "field" (node "field_access"))))
  (under (node "method_invocation")
    (as-use (take "name" (node "method_invocation"))))
  (under (node "method_reference")
    (as-use
      (take "name"
        (seq (capture name any) "::" (capture name any)))))
  (under (node "method_reference")
    (as-use (node "method_reference")))
  (under (node "switch_label")
    (under (node "identifier")
      (as-use)))

  (under (node "type_identifier")
    (as-use))
  (under (node "scoped_type_identifier")
    (as-use (seq (capture name any) "." (capture name any))))

  (under (node "annotation")
    (as-use (take "name" (node "annotation")))
    (under (node "element_value_pair")
      (as-use (scope name) (take "key" (node "element_value_pair")))))
  (under (node "marker_annotation")
    (as-use (take "name" (node "marker_annotation"))))
  (under (node "element_value_pair")
    (as-use (take "key" (node "element_value_pair"))))

  (under (node "object_creation_expression")
    (as-use (take "type" (node "object_creation_expression"))))

  (under (node "constructor_declaration")
    (as-use (take "name" (node "constructor_declaration"))))
  (under (node "compact_constructor_declaration")
    (as-scope (this))
    (as-use (take "name" (node "compact_constructor_declaration"))))

  (under (node "import_declaration")
    (as-use
      (take "name"
        (seq "static" (* (not ";")) "." (capture name any) ";"))))

  ;; keyword paint (token text — constant leaf glyphs)
  (as-keyword (alt
    (token "abstract") (token "assert") (token "boolean") (token "break")
    (token "byte") (token "case") (token "catch") (token "char")
    (token "class") (token "const") (token "continue") (token "default")
    (token "do") (token "double") (token "else") (token "enum")
    (token "exports") (token "extends") (token "final") (token "finally")
    (token "float") (token "for") (token "goto") (token "if")
    (token "implements") (token "import") (token "instanceof") (token "int")
    (token "interface") (token "long") (token "module") (token "native")
    (token "new") (token "non-sealed") (token "open") (token "opens")
    (token "package") (token "permits") (token "private") (token "protected")
    (token "provides") (token "public") (token "record") (token "requires")
    (token "return") (token "sealed") (token "short") (token "static")
    (token "strictfp") (token "switch") (token "synchronized") (token "throw")
    (token "throws") (token "to") (token "transient") (token "transitive")
    (token "try") (token "uses") (token "var") (token "void")
    (token "volatile") (token "while") (token "with") (token "yield")
    (token "when")))
  (as-ident (node "identifier"))
  (as-type (or (node "type_identifier") (node "scoped_type_identifier")))
  (as-string (or (node "string_literal") (node "character_literal") (node "escape_sequence") (node "text_block")))
  (as-number (or (node "decimal_integer_literal") (node "hex_integer_literal") (node "octal_integer_literal") (node "binary_integer_literal") (node "decimal_floating_point_literal") (node "hex_floating_point_literal")))
  (as-comment (or (node "comment") (node "line_comment") (node "block_comment")))
  (as-const (alt (token "true") (token "false") (token "null") (token "this") (token "super")))
  (as-op (alt (token "->") (token "::") (token "...")))

  (under (node "if_statement")
    (as-flow structural (take "consequence" (node "if_statement"))))
  (under (node "if_statement")
    (as-flow hybrid (take "alternative" (node "if_statement"))))
  (under (node "for_statement")
    (as-flow structural (take "body" (node "for_statement"))))
  (under (node "enhanced_for_statement")
    (as-flow structural (take "body" (node "enhanced_for_statement"))))
  (under (node "while_statement")
    (as-flow structural (take "body" (node "while_statement"))))
  (under (node "do_statement")
    (as-flow structural (take "body" (node "do_statement"))))
  (under (node "switch_expression")
    (as-flow structural (this)))
  (under (node "switch_statement")
    (as-flow structural (this)))
  (under (node "catch_clause")
    (as-flow structural (this)))
  (under (node "ternary_expression")
    (as-flow structural (this)))
  (under (node "lambda_expression")
    (as-flow structural (this)))
)
