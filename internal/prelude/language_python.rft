;; -*- mode: lisp; -*-
;; python — place wraps verb (SPEC.md Extract dialect).
;; Uses under def places use (scope name): from-where = enclosing def name.

(under (path "**/__init__.py")
  (as-directory-representant))

(under (path "**/*.py")
  (as-language "python")
  (as-layout import body)
  (as-family "python" reject-dunder-rename)
  (as-import (seq "from" path "import" leaf))
  (as-docstring body-string)

  (under (node "function_definition")
    (as-scope (this))
    (as-atom public (take "name" (seq "def" (capture name (regex "^[^_]")) "(")))
    (as-atom private (take "name" (seq "def" (capture name (regex "^_")) "(")))
    (under (node "parameters")
      (as-atom private (node "identifier")))
    (under (node "attribute")
      (as-use (scope name) (take "attribute" (node "attribute"))))
    (under (node "identifier")
      (as-use (scope name))))

  (under (node "async_function_definition")
    (as-scope (this)))

  (under (node "class_definition")
    (as-scope (this))
    (as-atom public (take "name" (seq "class" (capture name (regex "^[^_]")))))
    (as-atom private (take "name" (seq "class" (capture name (regex "^_")))))
    (under (node "function_definition")
      (as-scope (this))
      (as-atom public (take "name" (seq "def" (capture name (regex "^[^_]")) "(")))
    (as-atom private (take "name" (seq "def" (capture name (regex "^_")) "(")))
      (under (node "parameters")
        (as-atom private (node "identifier")))
      (under (node "attribute")
        (as-use (scope name) (take "attribute" (node "attribute"))))
      (under (node "identifier")
        (as-use (scope name))))
    (under (node "assignment")
      (as-atom public (take "name" (seq (capture name (regex "^[^_]")) "=")))
      (as-atom private (take "name" (seq (capture name (regex "^_")) "="))))
    ;; dataclass / ann-assign: value: int  /  count: int = 0
    (under (node "assignment")
      (as-atom public (take "name" (seq (capture name (regex "^[^_]")) ":")))
      (as-atom private (take "name" (seq (capture name (regex "^_")) ":"))))
    (under (node "class_definition")
      (as-atom public (take "name" (seq "class" (capture name (regex "^[^_]")))))
      (as-atom private (take "name" (seq "class" (capture name (regex "^_")))))
      (under (node "function_definition")
        (as-atom public (take "name" (seq "def" (capture name (regex "^[^_]")) "(")))
        (as-atom private (take "name" (seq "def" (capture name (regex "^_")) "("))))
      (under (node "assignment")
        (as-atom public (take "name" (seq (capture name (regex "^[^_]")) "=")))
        (as-atom private (take "name" (seq (capture name (regex "^_")) "="))))
      (under (node "assignment")
        (as-atom public (take "name" (seq (capture name (regex "^[^_]")) ":")))
        (as-atom private (take "name" (seq (capture name (regex "^_")) ":")))))
    (under (node "attribute")
      (as-use (scope name) (take "attribute" (node "attribute"))))
    (under (node "identifier")
      (as-use (scope name))))

  ;; PEP 695: type BoxAlias = …
  (under (node "type_alias_statement")
    (as-decl (this))
    (as-atom public (take "name" (seq "type" (capture name (regex "^[^_]")) "=")))
    (as-atom private (take "name" (seq "type" (capture name (regex "^_")) "="))))

  ;; module-level assignment (const-like)
  (under (node "assignment")
    (as-decl (this))
    (as-atom public (take "name" (seq (capture name (regex "^[^_]")) "=")))
    (as-atom private (take "name" (seq (capture name (regex "^_")) "="))))

  ;; import os / import os.path — name field is the dotted module path
  (under (node "import_statement")
    (as-import (take "path" (node "dotted_name"))))
  (under (node "import_statement")
    (under (node "dotted_as_name")
      (as-import (take "path" (node "dotted_name")))))
  (under (node "import_statement")
    (as-import (node "import_statement")))

  ;; from X import Y, Z as w — module_name + each name field (extract fans out)
  (under (node "import_from_statement")
    (as-import (take "path" (node "dotted_name"))))
  (under (node "import_from_statement")
    (as-import (take "path" (node "relative_import"))))
  (under (node "import_from_statement")
    (as-import (node "import_from_statement")))

  ;; file-level uses (no scope)
  (under (node "attribute")
    (as-use (take "attribute" (node "attribute"))))

  (under (node "identifier")
    (as-use))

  ;; __all__ = ["helper"] / __slots__ = ("helper",)
  (under (node "assignment")
    (under (node "list")
      (under (node "string_content")
        (as-use (this))))
    (under (node "tuple")
      (under (node "string_content")
        (as-use (this)))))

  ;; def use(b: "Box") -> "Box"
  (under (node "type")
    (under (node "string_content")
      (as-use (this))))

  ;; keyword paint (token text — constant leaf glyphs)
  (as-keyword (alt
    (token "and") (token "as") (token "assert") (token "async")
    (token "await") (token "break") (token "case") (token "class")
    (token "continue") (token "def") (token "del") (token "elif")
    (token "else") (token "except") (token "exec") (token "finally")
    (token "for") (token "from") (token "global") (token "if")
    (token "import") (token "in") (token "is") (token "lambda")
    (token "match") (token "nonlocal") (token "not") (token "or")
    (token "pass") (token "print") (token "raise") (token "return")
    (token "try") (token "type") (token "while") (token "with")
    (token "yield")))
  (as-ident (node "identifier"))
  (as-type (node "type_identifier"))
  (as-string (or (node "string") (node "string_content") (node "string_start") (node "string_end") (node "escape_sequence") (node "interpolation") (node "concatenated_string")))
  (as-number (or (node "integer") (node "float")))
  (as-comment (node "comment"))
  (as-const (alt (token "true") (token "false") (token "none") (token "True") (token "False") (token "None")))
  (as-op (alt (token "->") (token ":=") (token "**") (token "//")))

  (under (node "if_statement")
    (as-flow structural (take "consequence" (node "if_statement"))))
  (under (node "elif_clause")
    (as-flow hybrid (this)))
  (under (node "else_clause")
    (as-flow hybrid (this)))
  (under (node "for_statement")
    (as-flow structural (take "body" (node "for_statement"))))
  (under (node "while_statement")
    (as-flow structural (take "body" (node "while_statement"))))
  (under (node "except_clause")
    (as-flow structural (this)))
  (under (node "match_statement")
    (as-flow structural (this)))
  (under (node "lambda")
    (as-flow structural (this)))
  (under (node "conditional_expression")
    (as-flow structural (this)))
)
