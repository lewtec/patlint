;; -*- mode: lisp; -*-
;; svelte — place wraps verb (SPEC.md Extract dialect).

(under (path "**/*.svelte")
  (as-language "svelte")
  (as-family "ecma" directory-manifest dest-export)

  ;; <script> body → JavaScript embed (lang=ts files can switch later)
  (under (node "script_element")
    (under (node "raw_text")
      (as-language "javascript")))

  (under (node "tag_name")
    (as-use))

  ;; on:click={helper} — expr body is svelte_raw_text, not identifier
  (under (node "expression")
    (under (node "svelte_raw_text")
      (as-use (this))))

  (under (node "identifier")
    (as-use))

  ;; Svelte markup control words (host leaves when present)
  (as-keyword (alt
    (token "each") (token "then") (token "html") (token "render") (token "snippet")))
  (as-type (or (node "tag_name") (node "component_name")))
  (as-ident (or (node "attribute_name") (node "attribute") (node "attribute_identifier") (node "directive_name") (node "directive_value") (node "directive_modifier")))
  (as-string (or (node "attribute_value") (node "quoted_attribute_value") (node "attribute_backtick_string"))))

