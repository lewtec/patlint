;; -*- mode: lisp; -*-
;; scala — place wraps verb (SPEC.md Extract dialect).
;; Uses under def places use (scope name).

(under (path "**/*.scala")
  (as-language "scala")
  (as-layout package import body)
  (as-family "jvm" directory-module package-scoped-bare-names empty-package-dir-scoped nested-type-members)
  (as-import (seq "import" path))
  (as-docstring comment-before-c)

  (under (node "package_clause")
    (under (node "identifier")
      (as-package)))

  (under (node "class_definition")
    (as-scope (this))
    (as-atom public (take "name" (seq "class" (capture name any))))
    (under (node "function_definition")
      (as-scope (this))
      (as-atom public (take "name" (seq "def" (capture name any))))
      (under (node "field_expression")
        (as-use (scope name)
          (take "name"
            (seq (capture name any) "." (capture name any)))))
      (under (node "identifier")
        (as-use (scope name)))
      (under (node "type_identifier")
        (as-use (scope name))))
    (under (node "field_expression")
      (as-use (scope name)
        (take "name"
          (seq (capture name any) "." (capture name any)))))
    (under (node "identifier")
      (as-use (scope name)))
    (under (node "type_identifier")
      (as-use (scope name))))

  (under (node "object_definition")
    (as-scope (this))
    (as-atom public (take "name" (seq "object" (capture name any))))
    (under (node "function_definition")
      (as-scope (this))
      (as-atom public (take "name" (seq "def" (capture name any))))
      (under (node "identifier")
        (as-use (scope name))))
    (under (node "field_expression")
      (as-use (scope name)
        (take "name"
          (seq (capture name any) "." (capture name any)))))
    (under (node "identifier")
      (as-use (scope name)))
    (under (node "type_identifier")
      (as-use (scope name))))

  (under (node "trait_definition")
    (as-scope (this))
    (as-atom public (take "name" (seq "trait" (capture name any))))
    (under (node "function_definition")
      (as-scope (this))
      (as-atom public (take "name" (seq "def" (capture name any))))
      (under (node "identifier")
        (as-use (scope name)))))

  (under (node "function_definition")
    (as-scope (this))
    (as-atom public (take "name" (seq "def" (capture name any))))
    (under (node "field_expression")
      (as-use (scope name)
        (take "name"
          (seq (capture name any) "." (capture name any)))))
    (under (node "identifier")
      (as-use (scope name)))
    (under (node "type_identifier")
      (as-use (scope name))))

  (under (node "function_declaration")
    (as-scope (this)))

  (under (node "val_definition")
    (as-atom public (take "pattern" (node "val_definition"))))
  (under (node "var_definition")
    (as-atom public (take "pattern" (node "var_definition"))))

  (under (node "import_declaration")
    (as-import (take "path" (capture path any))))

  (under (node "field_expression")
    (as-use
      (take "name"
        (seq (capture name any) "." (capture name any)))))

  (under (node "identifier")
    (as-use))

  (under (node "type_identifier")
    (as-use))

  ;; keyword paint (token text — constant leaf glyphs)
  (as-keyword (alt
    (token "abstract") (token "case") (token "catch") (token "class")
    (token "def") (token "do") (token "else") (token "enum")
    (token "export") (token "extends") (token "extension") (token "final")
    (token "finally") (token "for") (token "given") (token "if")
    (token "implicit") (token "import") (token "lazy") (token "match")
    (token "new") (token "object") (token "override") (token "package")
    (token "private") (token "protected") (token "return") (token "sealed")
    (token "then") (token "throw") (token "trait") (token "try")
    (token "type") (token "val") (token "var") (token "while")
    (token "with") (token "yield") (token "using") (token "derives")
    (token "as") (token "end") (token "inline") (token "opaque")
    (token "open") (token "transparent") (token "tracked") (token "infix")
    (token "into")))
  (as-ident (or (node "identifier") (node "operator_identifier")))
  (as-type (or (node "type_identifier") (node "stable_type_identifier")))
  (as-string (or (node "string") (node "character_literal") (node "escape_sequence") (node "interpolated_string")))
  (as-number (or (node "integer_literal") (node "floating_point_literal")))
  (as-comment (or (node "comment") (node "block_comment")))
  (as-const (alt (token "true") (token "false") (token "null") (token "this") (token "super") (token "unit")))
  (as-op (alt (token "=>") (token "->") (token "<-") (token "<:") (token ">:") (token "<%") (token "=>>") (token "?=>") (token "@") (token "_")))

  (under (node "if_expression")
    (as-flow structural (take "consequence" (node "if_expression"))))
  (under (node "if_expression")
    (as-flow hybrid (take "alternative" (node "if_expression"))))
  (under (node "while_expression")
    (as-flow structural (this)))
  (under (node "for_expression")
    (as-flow structural (this)))
  (under (node "match_expression")
    (as-flow structural (this)))
  (under (node "catch_clause")
    (as-flow structural (this)))
)
